function calcularPopulacao() {

    let nigeria = 195.9;
    let china = 1393;

    let taxaNigeria = 0.038;
    let taxaChina = 0.0037;

    let ano = 2020;
    let anos = 0;

    let resultado = "";

    while (nigeria <= china) {

        resultado +=
            "Ano " + ano +
            " - Nigéria: " + nigeria.toFixed(2) +
            " milhões | China: " + china.toFixed(2) +
            " milhões<br>";

        nigeria = nigeria * (1 + taxaNigeria);
        china = china * (1 + taxaChina);

        ano++;
        anos++;
    }

    resultado += "<br>";
    resultado +=
        "<strong>A Nigéria ultrapassará a China em " +
        anos + " anos.</strong><br>";

    resultado +=
        "Ano: " + ano + "<br>";

    resultado +=
        "Nigéria: " + nigeria.toFixed(2) + " milhões<br>";

    resultado +=
        "China: " + china.toFixed(2) + " milhões";

    document.getElementById("resultado").innerHTML = resultado;
}
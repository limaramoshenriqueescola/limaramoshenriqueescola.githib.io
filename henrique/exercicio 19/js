function mostrarEco() {

    let quantidade =
        Number(document.getElementById("quantidade").value);

    let resultado = "";

    for (let linha = 1; linha <= quantidade; linha++) {

        for (let coluna = 1; coluna <= linha; coluna++) {

            resultado += "Olá ";
        }

        resultado += "<br>";
    }

    document.getElementById("resultado").innerHTML =
        resultado;
}
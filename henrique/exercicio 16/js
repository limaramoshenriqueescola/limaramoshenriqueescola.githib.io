function calcularAgua() {

    let agua = 150;
    let horas = 0;

    while (agua >= 7) {

        agua -= 7;

        horas++;
    }

    document.getElementById("resultado").innerHTML =
        "Quantidade de horas: " +
        horas +
        "<br>" +
        "Água restante: " +
        agua +
        " litros";
}